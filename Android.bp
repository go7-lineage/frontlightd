rust_binary {
    name: "frontlightd",
    crate_name: "frontlightd",
    srcs: ["src/main.rs"],
    edition: "2024",
    vendor: true,
    rustlibs: ["liblibc"],
    lints: "android",
    clippy_lints: "android",
    required: ["init.frontlight.rc"],
}

prebuilt_etc {
    name: "init.frontlight.rc",
    src: "init.frontlight.rc",
    sub_dir: "init",
    vendor: true,
}
